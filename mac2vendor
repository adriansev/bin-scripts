#!/usr/bin/env python3
"""Classify a single MAC address and resolve its vendor.

    mac_info.py <MAC>

Accepts colon, hyphen, Cisco-dotted, or bare-hex forms in any case
(e.g. 4c:56:df:46:22:57, 4C-56-DF-46-22-57, 4c56.df46.2257, 4c56df462257).

Prints the classification (universal/local + unicast/multicast) plus a
known-virtualization tag or an OUI-DB vendor lookup, identical to the
per-MAC "type=" field produced by mac_drop_stats.py.

Vendor lookup uses the keyless macvendors.com API (no API key), 1 s timeout,
attempted ONLY for universally-administered unicast MACs. The keyless tier is
documented at 1 req/s and 1000/day, so requests are throttled to 1 req/s by
default (override with MACVENDORS_MIN_INTERVAL seconds). Result tokens:
<vendor> / N/A (404) / TIMEOUT / ERR / HTTP<code> (e.g. HTTP429 if rate-limited).
Resolved vendors are cached in ~/.cache/mac_oui.cache, keyed by OUI, which also
conserves the daily quota across runs.

Exit status: 0 on success, 2 on a missing or malformed MAC argument.
"""
import os
import re
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request

# --- MAC classification -----------------------------------------------------
KNOWN_LOCAL_PREFIXES = {
    "52:54:00": "QEMU/KVM",
    "0a:00:27": "VirtualBox host-only",
    "02:42":    "Docker",
}
KNOWN_OUI_VM = {
    "00:16:3e": "Xen",
    "08:00:27": "VirtualBox",
    "00:0c:29": "VMware",
    "00:50:56": "VMware",
    "00:05:69": "VMware",
    "00:1c:42": "Parallels",
    "00:15:5d": "Hyper-V",
}

# --- OUI-DB vendor lookup (keyless macvendors.com API) + on-disk cache ------
MACVENDORS_URL = "https://api.macvendors.com/"   # keyless: GET .../<MAC>
LOOKUP_TIMEOUT = 1.0  # seconds
# Keyless tier is documented at 1 req/s (and 1000/day); throttle to match.
RATE_MIN_INTERVAL = float(os.environ.get("MACVENDORS_MIN_INTERVAL", "1.0"))
_last_request = [0.0]  # monotonic timestamp of the previous request start


def _throttle():
    wait = RATE_MIN_INTERVAL - (time.monotonic() - _last_request[0])
    if wait > 0:
        time.sleep(wait)
    _last_request[0] = time.monotonic()


CACHE_PATH = os.path.join(os.path.expanduser("~"), ".cache", "mac_oui.cache")
_cache = {}
_cache_loaded = False


def _load_cache():
    global _cache_loaded
    _cache_loaded = True
    try:
        with open(CACHE_PATH, encoding="utf-8") as f:
            for line in f:
                oui, sep, vendor = line.rstrip("\n").partition("\t")
                if sep and oui:
                    _cache[oui] = vendor
    except FileNotFoundError:
        pass
    except OSError:
        pass


def _cache_put(oui, vendor):
    _cache[oui] = vendor
    try:
        os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
        with open(CACHE_PATH, "a", encoding="utf-8") as f:
            f.write("%s\t%s\n" % (oui, vendor.replace("\t", " ")))
    except OSError:
        pass


def _ssl_context():
    """Verifying context by default.

    MACVENDORS_CA=/path/to/ca.pem  -> trust an explicit bundle/anchor
                                      (e.g. an intercepting-proxy or HARICA CA)
    MACVENDORS_INSECURE=1          -> disable verification (equivalent to the
                                      `curl -k` in the original mac2vendor).
                                      This turns off authentication of the peer
                                      -- use only if you accept the MITM risk.
    """
    if os.environ.get("MACVENDORS_INSECURE") == "1":
        return ssl._create_unverified_context()
    ca = os.environ.get("MACVENDORS_CA") or None
    return ssl.create_default_context(cafile=ca)  # ca=None -> system trust store


def _query_api(mac):
    _throttle()
    req = urllib.request.Request(MACVENDORS_URL + mac)
    try:
        with urllib.request.urlopen(req, timeout=LOOKUP_TIMEOUT,
                                    context=_ssl_context()) as r:
            return r.read().decode("utf-8", "replace").strip() or "N/A"
    except (socket.timeout, TimeoutError):
        return "TIMEOUT"
    except urllib.error.HTTPError as e:
        return "N/A" if e.code == 404 else "HTTP%d" % e.code
    except urllib.error.URLError as e:
        if isinstance(e.reason, (socket.timeout, TimeoutError)):
            return "TIMEOUT"
        return "ERR"
    except Exception:
        return "ERR"


# --- local Wireshark 'manuf' OUI file (consulted before the remote API) -----
MANUF_PATH = os.environ.get(
    "MACVENDORS_MANUF",
    os.path.join(os.path.expanduser("~"), "oui_manuf"),
)
_manuf = {}            # (maskbits, prefixvalue) -> vendor string
_manuf_masks = []      # distinct mask lengths present, sorted descending
_manuf_loaded = False


def _load_manuf():
    global _manuf_loaded
    _manuf_loaded = True
    try:
        f = open(MANUF_PATH, encoding="utf-8", errors="replace")
    except OSError:
        return  # absent -> lookups return None, fall through to the API
    masks = set()
    with f:
        for line in f:
            line = line.rstrip("\n")
            if not line or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t") if "\t" in line else line.split(None, 2)
            addr = parts[0].strip()
            short_name = parts[1].strip() if len(parts) > 1 else ""
            long_name = parts[2].strip() if len(parts) > 2 else ""
            vendor = long_name or short_name
            if not addr or not vendor:
                continue
            if "/" in addr:
                addr, _, bits = addr.partition("/")
                try:
                    bits = int(bits)
                except ValueError:
                    continue
            else:
                bits = None
            hexstr = re.sub(r"[^0-9a-fA-F]", "", addr).lower()
            if not hexstr or len(hexstr) > 12:
                continue
            if bits is None:
                bits = len(hexstr) * 4  # implied mask from prefix length
            if not 1 <= bits <= 48:
                continue
            prefix48 = int(hexstr.ljust(12, "0"), 16)
            _manuf[(bits, prefix48 >> (48 - bits))] = vendor
            masks.add(bits)
    _manuf_masks[:] = sorted(masks, reverse=True)


def _manuf_lookup(mac):
    """Longest-prefix (most specific mask first) match, or None."""
    if not _manuf_loaded:
        _load_manuf()
    if not _manuf:
        return None
    m = int(mac.replace(":", ""), 16)
    for bits in _manuf_masks:
        v = _manuf.get((bits, m >> (48 - bits)))
        if v is not None:
            return v
    return None


def lookup_vendor(mac):
    if not _cache_loaded:
        _load_cache()
    oui = mac[:8]
    if oui in _cache:
        return _cache[oui]
    hit = _manuf_lookup(mac)          # local oui_manuf before the remote query
    if hit is not None:
        return hit
    result = _query_api(mac)
    if result != "TIMEOUT" and result != "ERR" and not result.startswith("HTTP"):
        _cache_put(oui, result)
    return result


def known_prefix(mac):
    for n in (8, 5):
        p = mac[:n]
        if p in KNOWN_LOCAL_PREFIXES:
            return KNOWN_LOCAL_PREFIXES[p]
        if p in KNOWN_OUI_VM:
            return KNOWN_OUI_VM[p]
    return None


def classify(mac):
    first = int(mac[:2], 16)
    admin = "local" if first & 0x02 else "universal"
    cast = "multicast" if first & 0x01 else "unicast"
    label = "%s/%s" % (admin, cast)
    kp = known_prefix(mac)
    if kp:
        return "%s [%s]" % (label, kp)
    if admin == "universal" and cast == "unicast":
        return "%s [%s]" % (label, lookup_vendor(mac))
    return label


def normalize_mac(s):
    """Return canonical 'xx:xx:xx:xx:xx:xx' lowercase, or None if not 48-bit."""
    hexstr = re.sub(r"[^0-9a-fA-F]", "", s).lower()
    if len(hexstr) != 12:
        return None
    return ":".join(hexstr[i:i + 2] for i in range(0, 12, 2))


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: %s <MAC>\n" % os.path.basename(argv[0]))
        return 2
    mac = normalize_mac(argv[1])
    if mac is None:
        sys.stderr.write("error: not a valid 48-bit MAC: %s\n" % argv[1])
        return 2
    print("%s  %s" % (mac, classify(mac)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))


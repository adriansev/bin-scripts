#!/usr/bin/env bash
#
# certkeymatch.sh - verify that an X.509 certificate and a private key belong together.
#
# Usage: certkeymatch.sh [-v] <certificate> <key>
#
# Exit codes:
#   0  MATCH
#   1  NOTMATCH
#   2  usage error / unreadable file / parse error

set -o nounset -o pipefail

usage() {
    printf 'Usage: %s [-v] <certificate> <key>\n' "${0##*/}" >&2
    exit 2
}

die() {
    printf 'ERROR: %s\n' "$1" >&2
    exit 2
}

verbose=0
while getopts ':v' opt; do
    case "$opt" in
        v)  verbose=1 ;;
        \?) usage ;;
    esac
done
shift $((OPTIND - 1))

[ "$#" -eq 2 ] || usage

cert=$1
key=$2

for f in "$cert" "$key"; do
    [ -e "$f" ] || die "no such file: $f"
    [ -f "$f" ] || die "not a regular file: $f"
    [ -r "$f" ] || die "not readable: $f"
    [ -s "$f" ] || die "file is empty: $f"
done

# Compare the SubjectPublicKeyInfo of both objects. This is algorithm-agnostic
# (RSA, EC, Ed25519) unlike -modulus, which is RSA-only.
cert_pub=$(openssl x509 -in "$cert" -noout -pubkey) \
    || die "cannot parse certificate: $cert"
key_pub=$(openssl pkey -in "$key" -pubout) \
    || die "cannot parse private key: $key"

if [ "$verbose" -eq 1 ]; then
    cert_hash=$(printf '%s\n' "$cert_pub" | openssl dgst -sha256 | awk '{print $NF}')
    key_hash=$(printf '%s\n' "$key_pub"  | openssl dgst -sha256 | awk '{print $NF}')
    printf 'cert %s  %s\n' "$cert_hash" "$cert"
    printf 'key  %s  %s\n' "$key_hash"  "$key"
fi

if [ "$cert_pub" = "$key_pub" ]; then
    echo "MATCH"
    exit 0
else
    echo "NOTMATCH"
    exit 1
fi
